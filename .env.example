# API keys for mini-agent providers
#
# Copy this file to .env and fill in your real keys:
#     cp .env.example .env
#
# .env is gitignored. Only the example template (this file) is tracked.
# The .env loader uses python-dotenv semantics: existing shell env wins,
# so `export OPENAI_API_KEY=...` before `python3` overrides this file.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-key

# OpenRouter (https://openrouter.ai/keys)
# Sign in, create a key, then set this to use any model from openrouter.
OPENROUTER_API_KEY=sk-or-your-openrouter-key
